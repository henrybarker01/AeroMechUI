{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Backup": {
    "ConnectionString": "Host=localhost;Port=5432;Database=aeromechdb;Username=postgres;Password=;Include Error Detail=true",
    "DatabaseName": "aeromechdb",
    "SqlServerBackupPath": "D:\\SqlBackups",
    "OneDriveTargetFolder": "C:\\Users\\<you>\\OneDrive\\SQLBackups",
    "RetentionDays": 14,
    "RunAtHour": 2,
    "RunAtMinute": 0,
    "BackupAtStartup": true,
    "PgDumpPath": "C:\\Program Files\\PostgreSQL\\18\\bin\\pg_dump.exe",
    "PgRestorePath": "C:\\Program Files\\PostgreSQL\\18\\bin\\pg_restore.exe"
  }
}
