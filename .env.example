POSTGRES_USER=aeromech
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aeromech
# Use Development locally (allows HTTP login cookies); Production behind TLS on Lightsail
ASPNETCORE_ENVIRONMENT=Development

# Test environment (https://test.vmi.aeromech.co, docker-compose.test.yml)
# Separate checkout that web-test builds from; deploy-test.sh switches its branch
TEST_BUILD_CONTEXT=../AeroMechUI-test
TEST_POSTGRES_DB=aeromech_test
# Initial user seeded into the empty test database on first start
TEST_SEED_USERNAME=admin
TEST_SEED_EMAIL=admin@aeromech.co
TEST_SEED_PASSWORD=change-me
