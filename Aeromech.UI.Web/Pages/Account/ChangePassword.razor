@page "/change-password"
@inject LocalizationService L
@attribute [Authorize]

<PageTitle>@L["Change Password"]</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h4 mb-0">@L["Change Password"]</h1>
            <small class="text-muted">@L["Choose a new password for your account."]</small>
        </div>
    </div>

    @if (Forced == 1)
    {
        <div class="row">
            <div class="col-12 col-md-6">
                <div class="alert alert-warning" role="alert">
                    @L["Your password was assigned for you. Choose your own before continuing."]
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="row">
            <div class="col-12 col-md-6">
                <div class="alert alert-danger" role="alert">
                    @_errorMessage
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault="true">
                        <div class="form-group mb-3">
                            <label for="current-password">@L["Current password"]:</label>
                            <input type="password" class="form-control" id="current-password"
                                   autocomplete="current-password" @bind="_currentPassword" />
                        </div>
                        <div class="form-group mb-3">
                            <label for="new-password">@L["New password"]:</label>
                            <input type="password" class="form-control" id="new-password"
                                   autocomplete="new-password" @bind="_newPassword" />
                        </div>
                        <div class="form-group mb-4">
                            <label for="confirm-new-password">@L["Confirm new password"]:</label>
                            <input type="password" class="form-control" id="confirm-new-password"
                                   autocomplete="new-password" @bind="_confirmNewPassword" />
                        </div>
                        <div class="d-flex justify-content-end">
                            <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">@L["Change password"]</Button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
