@page "/reports"

@inject NavigationManager Navigation

<PageTitle>Reports</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="mb-0">Reports</h1>
            <small class="text-muted">Generate and download PDF reports.</small>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var report in _reports)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <div class="fw-semibold">@report.Name</div>
                            @if (!string.IsNullOrWhiteSpace(report.Description))
                            {
                                <div class="text-muted small">@report.Description</div>
                            }
                        </div>

                        <div class="mt-auto d-flex justify-content-end">
                            @if (!string.IsNullOrWhiteSpace(report.Route))
                            {
                                <button class="btn btn-primary btn-sm" @onclick="() => Navigation.NavigateTo(report.Route)">Run</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-sm" disabled>Coming soon</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private sealed record ReportRow(string Name, string? Description, string? Route);

    private readonly List<ReportRow> _reports = new()
    {
        new("Field Service Report", "Service report PDF for a selected report.", null),
        new("Material Requisition", "Generate material requisition PDF.", null),
        new("Employee Potential", "Employee potential summary report.", null),
        new("Stock Count Sheet", "Blank count sheet to walk the shelves with, or the sheet for a stock take.", "/ShowStockTakeSheet"),
        new("Stock Movement", "Opening level, every movement and closing level for a period.", "/ShowStockMovementReport"),
        new("Stock Valuation", "Current stock per supplier, with cost price and total value.", "/ShowStockValuationReport"),
        new("Timesheet", "Weekly timesheet matrix by employee.", "/ShowTimesheetReport"),
        new("Vehicle Part No Service Record", "Vehicles missing service record part numbers.", null),
        new("Vehicle Service Record", "Vehicle service record history.", null),
        new("Vehicle Type Service Record", "Service records grouped by vehicle type.", null)
    };
}