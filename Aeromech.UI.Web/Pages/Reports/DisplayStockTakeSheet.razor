@page "/ShowStockTakeSheet"
@page "/ShowStockTakeSheet/{StockTakeId:int}"

@using AeroMech.Data.Enums
@using BlazorBootstrap

<PageTitle>Stock Count Sheet</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h4 mb-0">Stock Count Sheet</h1>
            <small class="text-muted">
                Print a blank sheet to walk the shelves with, or reprint the sheet for a stock take that has been raised.
            </small>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-auto">
            <div class="btn-group" role="group" aria-label="Sheet source">
                <button type="button"
                        class="btn @(_mode == SheetMode.Blank ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetMode(SheetMode.Blank)">
                    Blank sheet
                </button>
                <button type="button"
                        class="btn @(_mode == SheetMode.StockTake ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetMode(SheetMode.StockTake)">
                    Existing stock take
                </button>
            </div>
        </div>
    </div>

    @if (_mode == SheetMode.Blank)
    {
        <div class="row align-items-end mb-3">
            <div class="col-12 col-md-4">
                <label for="blank-description" class="form-label">Heading</label>
                <input type="text" class="form-control" id="blank-description"
                       placeholder="Ad-hoc count"
                       @bind="_request.StockTakeDescription" @bind:event="oninput" />
                <div class="form-text">Printed at the top of the sheet so it can be told apart on paper.</div>
            </div>

            <div class="col-6 col-md-2">
                <label for="blank-date" class="form-label">Date</label>
                <input type="date" class="form-control" id="blank-date"
                       value="@_request.StockTakeDate.ToString("yyyy-MM-dd")"
                       @onchange="OnDateChanged" />
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label">Suppliers</label>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start text-truncate"
                            type="button"
                            id="blank-supplier-filter"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        @SelectedSuppliersLabel
                    </button>
                    <div class="dropdown-menu w-100 p-2" aria-labelledby="blank-supplier-filter">
                        <div class="panel-scroll">
                            @if (_suppliers.Count == 0)
                            {
                                <div class="text-muted small px-1">No suppliers available</div>
                            }
                            else
                            {
                                @foreach (var supplier in _suppliers)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="@($"blank-supplier-{supplier.SupplierCode}")"
                                               checked="@_selectedSuppliers.Contains(supplier.SupplierCode)"
                                               @onchange="@(e => ToggleSupplier(supplier.SupplierCode, (bool?)e.Value == true))" />
                                        <label class="form-check-label" for="@($"blank-supplier-{supplier.SupplierCode}")">
                                            @supplier.SupplierCode <span class="text-muted">(@supplier.PartCount)</span>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                        <hr class="my-2" />
                        <button type="button" class="btn btn-sm btn-link p-0" @onclick="ClearSupplierSelection">
                            Clear selection (count everything)
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <label for="blank-order" class="form-label">Sheet order</label>
                <select class="form-select" id="blank-order" @onchange="OnOrderChanged">
                    <option value="@((int)StockTakeSheetOrder.SupplierThenPart)" selected="@(_order == StockTakeSheetOrder.SupplierThenPart)">Supplier, then part</option>
                    <option value="@((int)StockTakeSheetOrder.BinThenPart)" selected="@(_order == StockTakeSheetOrder.BinThenPart)">Bin, then part</option>
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-12 col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="blank-blind" @bind="_request.BlindCount" />
                    <label class="form-check-label" for="blank-blind">
                        Blind count &mdash; leave the expected quantity off the sheet
                    </label>
                </div>
            </div>
            <div class="col-12 col-md-5">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="blank-exclude-zero" @bind="_request.ExcludeZeroQtyParts" />
                    <label class="form-check-label" for="blank-exclude-zero">
                        Leave out parts the system already shows as empty
                    </label>
                </div>
            </div>
        </div>

        <div class="alert alert-light border py-2 small">
            Printing this raises nothing and records nothing. It is a sheet to write on &mdash; for a count that posts
            against stock, raise a stock take from <a href="/stock-takes">Stock Takes</a>.
        </div>
    }
    else
    {
        <div class="row align-items-end mb-3">
            <div class="col-12 col-md-6">
                <label for="stock-take" class="form-label">Stock take</label>
                @if (_stockTakes.Count == 0)
                {
                    <div class="form-control-plaintext text-muted">No stock takes have been raised yet.</div>
                }
                else
                {
                    <select class="form-select" id="stock-take" @onchange="OnStockTakeChanged">
                        @foreach (var take in _stockTakes)
                        {
                            <option value="@take.Id" selected="@(_selectedId == take.Id)">@DescribeTake(take)</option>
                        }
                    </select>
                }
            </div>

            <div class="col-12 col-md-3">
                <label for="take-order" class="form-label">Sheet order</label>
                <select class="form-select" id="take-order" @onchange="OnOrderChanged" disabled="@(_stockTakes.Count == 0)">
                    <option value="@((int)StockTakeSheetOrder.SupplierThenPart)" selected="@(_order == StockTakeSheetOrder.SupplierThenPart)">Supplier, then part</option>
                    <option value="@((int)StockTakeSheetOrder.BinThenPart)" selected="@(_order == StockTakeSheetOrder.BinThenPart)">Bin, then part</option>
                </select>
                <div class="form-text">Bin order reads in the order the shelves are walked.</div>
            </div>
        </div>
    }

    <div class="row mb-3">
        <div class="col text-end">
            <Button Color="ButtonColor.Primary" @onclick="ViewReport" Class="me-2" Disabled="!CanGenerate">
                <i class="bi bi-file-pdf me-1"></i>@(_mode == SheetMode.Blank ? "Generate sheet" : "View report")
            </Button>
            <Button Color="ButtonColor.Secondary" @onclick="DownloadPdf" Disabled="_pdfBytes is null">
                <i class="bi bi-download me-1"></i>Download PDF
            </Button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_pdfBase64String))
    {
        <PdfViewer @key="_reportVersion" Class="mb-3"
                   Url='@string.Format("data:application/pdf;base64,{0}", _pdfBase64String)'
                   OnDocumentLoaded="OnDocumentLoaded"
                   OnPageChanged="OnPageChanged" />
    }
</div>
