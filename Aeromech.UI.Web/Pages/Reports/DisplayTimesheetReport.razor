@page "/ShowTimesheetReport"
@page "/ShowTimesheetReport/{ReportDate}"
@using BlazorBootstrap

<PageTitle>Timesheet Report</PageTitle>

<div class="container-fluid">
    <div class="row align-items-end mb-3">
        <div class="col-3">
            <label for="report-type" class="form-label">Report Type</label>
            <InputSelect @bind-Value="_reportType" class="form-select" id="report-type">
                <option value="@ReportType.Weekly">Weekly</option>
                <option value="@ReportType.Daily">Daily</option>
                <option value="@ReportType.DateRange">Date Range</option>
            </InputSelect>
        </div>

        @if (_reportType == ReportType.Weekly)
        {
            <div class="col-3">
                <label for="week-start" class="form-label">Week starting</label>
                <InputDate TValue="DateOnly"
                           Value="_weekStart"
                           ValueChanged="OnWeekStartChanged"
                           ValueExpression="(() => _weekStart)"
                           class="form-control"
                           id="week-start" />
            </div>
        }
        else if (_reportType == ReportType.Daily)
        {
            <div class="col-3">
                <label for="date" class="form-label">Date</label>
                <InputDate TValue="DateOnly"
                           Value="_selectedDate"
                           ValueChanged="OnSelectedDateChanged"
                           ValueExpression="(() => _selectedDate)"
                           class="form-control"
                           id="date" />
            </div>
        }
        else if (_reportType == ReportType.DateRange)
        {
            <div class="col-3">
                <label for="from-date" class="form-label">From Date</label>
                <InputDate TValue="DateOnly"
                           Value="_fromDate"
                           ValueChanged="OnFromDateChanged"
                           ValueExpression="(() => _fromDate)"
                           class="form-control"
                           id="from-date" />
            </div>
            <div class="col-3">
                <label for="to-date" class="form-label">To Date</label>
                <InputDate TValue="DateOnly"
                           Value="_toDate"
                           ValueChanged="OnToDateChanged"
                           ValueExpression="(() => _toDate)"
                           class="form-control"
                           id="to-date" />
            </div>
        }

        <div class="col-3">
            <label class="form-label">Clients</label>
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start text-truncate"
                        type="button"
                        id="client-filter"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false">
                    @SelectedClientsLabel
                </button>
                <div class="dropdown-menu w-100 p-2" aria-labelledby="client-filter">
                    <div style="max-height: 260px; overflow-y: auto;">
                        @if (_clients.Count == 0)
                        {
                            <div class="text-muted small px-1">No clients available</div>
                        }
                        else
                        {
                            @foreach (var client in _clients)
                            {
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="@($"client-{client.Id}")"
                                           checked="@_selectedClientIds.Contains(client.Id)"
                                           @onchange="@(e => ToggleClient(client.Id, (bool?)e.Value == true))" />
                                    <label class="form-check-label" for="@($"client-{client.Id}")">@client.Name</label>
                                </div>
                            }
                        }
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between">
                        <button class="btn btn-sm btn-link p-0" type="button" @onclick="ClearClientSelection">Clear (all clients)</button>
                        <button class="btn btn-sm btn-primary" type="button" @onclick="ViewReport">Apply</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col text-end">
            <Button Color="ButtonColor.Primary" @onclick="ViewReport" Class="me-2">
                <i class="bi bi-file-pdf me-1"></i>View Report
            </Button>
            <Button Color="ButtonColor.Secondary" @onclick="DownloadPdf" Class="me-2" Disabled="_pdfBytes is null">
                <i class="bi bi-download me-1"></i>Download PDF
            </Button>
            <Button Color="ButtonColor.Success" @onclick="ExportToExcel">
                <i class="bi bi-file-earmark-excel me-1"></i>Export to Excel
            </Button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_pdfBase64String))
    {
        <PdfViewer @key="_reportVersion" Class="mb-3"
                   Url='@string.Format("data:application/pdf;base64,{0}", _pdfBase64String)'
                   OnDocumentLoaded="OnDocumentLoaded"
                   OnPageChanged="OnPageChanged" />
    }
</div>
