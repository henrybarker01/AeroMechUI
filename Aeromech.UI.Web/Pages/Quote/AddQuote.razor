@using AeroMech.Models;
@using AeroMech.Models.Enums
@using AeroMech.Models.Models
@using System.Globalization
@using BlazorBootstrap

@page "/add-quote"
@page "/add-quote/{quoteId:int}"
@inject LocalizationService L

<PageTitle>@L["Quote"]</PageTitle>


<div class="container-fluid">
    <div class="row">
        <div class="col-11">
            <h1>@L["Quote"] @(_quote.QuoteNumber > 0 ? $"AEM {_quote.QuoteNumber}" : string.Empty)</h1>
        </div>
    </div>

    @if (_quote.IsConverted)
    {
        <div class="alert alert-info mt-2" role="alert">
            @L.Format("This quote was converted to service report AEM {0} on {1}, so it can no longer be changed.", _quote.ServiceReportNumber, _quote.ConvertedDate?.ToString("dd/MM/yyyy"))
        </div>
    }

    <EditForm EditContext="editContext">
        <DataAnnotationsValidator />
        <fieldset disabled="@_quote.IsConverted">
            <div class="row mt-3">
                <div class="col-6">
                    <div class="form-group">
                        <label for="quote-date">@L["Date"]:</label>
                        <InputDate @bind-Value="_quote.QuoteDate" class="form-control" id="quote-date"></InputDate>
                        <ValidationMessage For="() => _quote.QuoteDate" />
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="vehicle-hours">@L["Vehicle hours"]:</label>
                        <NumberInput @bind-Value="_quote.VehicleHours" type="text" class="form-control" id="vehicle-hours"></NumberInput>
                        <ValidationMessage For="() => _quote.VehicleHours" />
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-6">
                    <div class="form-group">
                        <label for="select-client">@L["Client"]:</label>
                        <InputSelect class="form-select"
                                     id="select-client"
                                     ValueExpression="@(()=>_quote.ClientId)"
                                     Value="@_quote.ClientId"
                                     ValueChanged="@((int value) => HandleOnChangeClient(value))">
                            <option selected value="0">@L["Select client"]</option>
                            @foreach (var client in clients)
                            {
                                <option value="@client.Id">@client.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _quote.ClientId" />
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="select-vehicle">@L["Vehicle"]:</label>
                        <InputSelect class="form-select" id="select-vehicle"
                                     ValueExpression="@(()=>_quote.VehicleId)"
                                     Value="@_quote.VehicleId"
                                     ValueChanged="@((int value) => HandleOnChangeVehicle(value))">
                            <option selected value="0">@L["Select vehicle"]</option>
                            @foreach (var vehicle in vehicles)
                            {
                                <option value="@vehicle.Id">@vehicle.MachineType @vehicle.SerialNumber</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _quote.VehicleId" />
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-6">
                    <div class="form-group">
                        <label for="service-type">@L["Service Type"]:</label>
                        <InputSelect class="form-select" id="service-type"
                                     ValueExpression="@(()=>_quote.ServiceType)"
                                     Value="@_quote.ServiceType"
                                     ValueChanged="@((ServiceType serviceType) => HandleOnServiceTypeChange(serviceType))">
                            <option selected value="0">@L["Select service type"]</option>
                            @foreach (var serviceType in Enum.GetValues(typeof(ServiceType)))
                            {
                                <option value="@serviceType">@serviceType</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _quote.ServiceType" />
                    </div>
                </div>
            </div>

            @* Labour is quoted per rate type. Who actually does the work is not known yet, and is
               only captured when the quote is converted into a service report. *@
            <div class="data-card mt-4">
                <div class="data-card-header">
                    <h2 class="data-card-title">@L["Labour"]</h2>
                    <span class="data-card-note">
                        @L.Format("Quoted per rate type at the client's rates — total {0}", _quote.Labour.Where(x => !x.IsDeleted).Sum(LabourTotal).ToString("F", CultureInfo.InvariantCulture))
                    </span>
                </div>
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>@L["Rate Type"]</th>
                            <th>@L["Rate"]</th>
                            <th>@L["Hours"]</th>
                            <th>@L["Total"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var labour in _quote.Labour.Where(x => !x.IsDeleted))
                        {
                            <tr>
                                <td>
                                    <InputSelect Value="@labour.RateType"
                                                 ValueExpression="@(() => labour.RateType)"
                                                 ValueChanged="@((RateType rateType) => HandleOnChangeRateType(labour, rateType))"
                                                 class="form-select">
                                        @foreach (var rate in RateTypes)
                                        {
                                            <option value="@rate">@rate.GetDisplayName()</option>
                                        }
                                    </InputSelect>
                                </td>
                                @* The rate is the client's, so it is shown rather than offered
                                   for editing. A blank means the rate card has nothing for this
                                   rate type, which is worth saying plainly. *@
                                <td class="align-middle">
                                    @if (labour.Rate > 0)
                                    {
                                        @labour.Rate.ToString("F", CultureInfo.InvariantCulture)
                                    }
                                    else if (_quote.ClientId == 0)
                                    {
                                        <span class="text-muted">@L["Select a client"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger" title="@L.Format("This client has no rate on file for {0}", labour.RateType.GetDisplayName())">@L["No rate on file"]</span>
                                    }
                                </td>
                                <td>
                                    <NumberInput TValue="double" @bind-Value="@labour.Hours" Placeholder="@L["Enter hours"]" Step=".01" />
                                </td>
                                <td class="align-middle">
                                    @LabourTotal(labour).ToString("F", CultureInfo.InvariantCulture)
                                </td>
                                <td class="row-actions-col">
                                    <RowActions>
                                        <RowAction Icon="@Icons.Remove" Label="@L["Remove this labour line"]" Danger="true"
                                                   OnClick="() => RemoveLabour(labour)" />
                                    </RowActions>
                                </td>
                            </tr>
                        }
                        <tr class="add-row">
                            <td>
                                <InputSelect class="form-select"
                                             id="select-rate-type"
                                             ValueExpression="@(()=>selectedRateType)"
                                             Value="@selectedRateType"
                                             ValueChanged="@((RateType value) => AddLabour(value))">
                                    <option selected value="@RateType.None">@L["Add labour"]</option>
                                    @foreach (var rate in RateTypes.Where(x => x != RateType.None))
                                    {
                                        <option value="@rate">@rate.GetDisplayName()</option>
                                    }
                                </InputSelect>
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @* Quoting a part prices it, it does not issue it, so nothing here moves stock. *@
            <div class="data-card">
                <div class="data-card-header">
                    <h2 class="data-card-title">@L["Parts"]</h2>
                    <span class="data-card-note">
                        @L.Format("Priced only — stock moves on conversion — total {0}", _quote.Parts.Where(x => !x.IsDeleted).Sum(PartTotal).ToString("F", CultureInfo.InvariantCulture))
                    </span>
                </div>
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>@L["Part Number"]</th>
                            <th>@L["Description"]</th>
                            <th>@L["C.P.U."]</th>
                            <th>@L["Qty"]</th>
                            <th>@L["Total"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var part in _quote.Parts.Where(x => !x.IsDeleted))
                        {
                            <tr>
                                <td>
                                    @if (part.IsAdHockPart)
                                    {
                                        <InputText @bind-Value="part.PartCode" type="text" class="form-control"></InputText>
                                    }
                                    else
                                    {
                                        @part.PartCode
                                    }
                                </td>
                                <td>
                                    @if (part.IsAdHockPart)
                                    {
                                        <InputText @bind-Value="part.PartDescription" type="text" class="form-control"></InputText>
                                    }
                                    else
                                    {
                                        @part.PartDescription
                                    }
                                </td>
                                <td>
                                    <NumberInput TValue="double" @bind-Value="@part.CostPrice" Placeholder="@L["Enter Cost Price"]" Step="0.01" />
                                </td>
                                <td>
                                    <NumberInput TValue="int" @bind-Value="@part.QTY" Placeholder="@L["Enter qty"]" />
                                </td>
                                <td>
                                    @PartTotal(part).ToString("F", CultureInfo.InvariantCulture)
                                </td>
                                <td class="row-actions-col">
                                    <RowActions>
                                        <RowAction Icon="@Icons.Remove" Label="@L["Remove this part"]" Danger="true"
                                                   OnClick="() => RemovePart(part)" />
                                    </RowActions>
                                </td>
                            </tr>
                        }
                        <tr class="add-row">
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @L["Select Part"]
                                    </button>
                                    <div class="dropdown-menu p-3 dropdown-scroll">
                                        <input type="text" class="form-control mb-2" placeholder="@L["Search part..."]"
                                               @oninput="(e) => SearchTerm = e.Value.ToString()" />
                                        <ul class="list-unstyled">
                                            <li @onclick="() => HandleOnChangePart(999999)" class="dropdown-item">@L["Non Stock"]</li>
                                            @foreach (var prt in FilteredParts)
                                            {
                                                <li @onclick="() => HandleOnChangePart(prt.Id)" class="dropdown-item">
                                                    @prt.PartCode @prt.PartDescription
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <br />
            <div class="row mt-3">
                <div class="col-6">
                    <div class="form-group">
                        <label for="instruction">@L["Instruction"]:</label>
                        <InputText @bind-Value="_quote.Instruction" type="text" class="form-control" id="instruction"></InputText>
                        <ValidationMessage For="() => _quote.Instruction" />
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label for="detailed-service-report">@L["Detailed Service Report"]:</label>
                        <InputTextArea @bind-Value="_quote.DetailedServiceReport" type="text" class="form-control" id="detailed-service-report"></InputTextArea>
                        <ValidationMessage For="() => _quote.DetailedServiceReport" />
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="container-fluid page-footer">
            <div class="row">
                <div class="footer-buttons">
                    @if (_quote.IsConverted)
                    {
                        <Button class="fsr-button" Color="ButtonColor.Secondary" @onclick="PrintQuote" Style="margin-right 20px">@L["Print Quote"]</Button>
                        <Button class="fsr-button" Color="ButtonColor.Primary" @onclick="OpenServiceReport">@L["Open Service Report"]</Button>
                    }
                    else
                    {
                        <Button class="fsr-button" Color="ButtonColor.Primary" @onclick="Save" Style="margin-right 20px">@L["Save"]</Button>
                        <Button class="fsr-button" Color="ButtonColor.Secondary" @onclick="SaveAndPrint" Style="margin-right 20px">@L["Save & Print Quote"]</Button>
                        <Button class="fsr-button" Color="ButtonColor.Secondary" @onclick="SaveAndNew" Style="margin-right 20px">@L["Save & New"]</Button>
                        @if (_quote.Id != 0)
                        {
                            <Button class="fsr-button" Color="ButtonColor.Success" @onclick="ConvertToServiceReport">@L["Convert to Service Report"]</Button>
                        }
                    }
                </div>
            </div>
        </div>
    </EditForm>
</div>
