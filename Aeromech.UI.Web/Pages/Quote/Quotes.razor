@page "/quotes"
@inject LocalizationService L
@using AeroMech.Models.Models

<PageTitle>@L["Quotes"]</PageTitle>

<ListTemplate TItem="QuoteModel"
          Title="Quotes"
          Eyebrow="Workshop"
          Items="_quotes"
          PageSize="15"
          SearchPredicate="MatchesSearch"
          ShowAddButton="true"
          StorageKey="quotes"
          OnAdd="NavigateToAddQuote">
    <HeaderTemplate>
        <tr>
            <SortHeader Title="Quote Number" SortBy="q => q.QuoteNumber" />
            <SortHeader Title="Quote Date" SortBy="q => q.QuoteDate" />
            <SortHeader Title="Serial Number" SortBy="q => q.Vehicle?.SerialNumber" />
            <SortHeader Title="Instruction" SortBy="q => q.Instruction" />
            <SortHeader Title="Client" SortBy="q => q.Client?.Name" />
            <SortHeader Title="Service Type" SortBy="q => q.ServiceType.ToString()" />
            <SortHeader Title="Total" SortBy="q => CalculateTotal(q)" />
            <SortHeader Title="Status" SortBy="q => q.IsConverted" />
            <th class="row-actions-col">@L["Actions"]</th>
        </tr>
    </HeaderTemplate>

    <RowTemplate Context="q">
        <tr>
            <td>@($"AEM {q.QuoteNumber}")</td>
            <td>@q.QuoteDate.ToString("dd/MM/yyyy")</td>
            <td>@q.Vehicle?.SerialNumber</td>
            <td class="instruction-col">@q.Instruction</td>
            <td>@q.Client?.Name</td>
            <td>@q.ServiceType</td>
            <td>@CalculateTotal(q).ToString("C", CultureInfo.CurrentCulture)</td>
            <td>
                @if (q.IsConverted)
                {
                    <span title="@L["Converted to a service report"]">@L.Format("Converted to AEM {0}", q.ServiceReportNumber)</span>
                }
                else
                {
                    <span>@L["Open"]</span>
                }
            </td>
            <td class="row-actions-col">
                <RowActions>
                    <RowAction Icon="@Icons.Edit" Label="@L["Edit this quote"]" OnClick="() => EditQuote(q.Id)" />
                    <RowAction Icon="@Icons.Print" Label="@L["Print this quote"]" OnClick="() => PrintQuote(q.Id)" />
                    @if (!q.IsConverted)
                    {
                        <RowAction Icon="@Icons.Convert" Label="@L["Convert to a service report"]" OnClick="() => ConvertQuote(q.Id)" />
                    }
                </RowActions>
            </td>
        </tr>
    </RowTemplate>
</ListTemplate>
