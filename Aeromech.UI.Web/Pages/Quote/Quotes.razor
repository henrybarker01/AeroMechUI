@page "/quotes"

<PageTitle>Quotes</PageTitle>

<ListTemplate TItem="ServiceReportModel"
          Title="Quotes"
          Items="_quotes"
          PageSize="15"
          SearchPredicate="MatchesSearch"
          ShowAddButton="true"
          StorageKey="quotes"
          OnAdd="NavigateToAddQuote">
    <HeaderTemplate>
        <tr>
            <SortHeader Title="Quote Number" SortBy="q => q.QuoteNumber" />
            <SortHeader Title="Report Number" SortBy="q => q.ServiceReportNumber" />
            <SortHeader Title="Report Date" SortBy="q => q.ReportDate" />
            <SortHeader Title="Serial Number" SortBy="q => q.Vehicle?.SerialNumber" />
            <SortHeader Title="Instruction" SortBy="q => q.Instruction" />
            <SortHeader Title="Client" SortBy="q => q.Client?.Name" />
            <SortHeader Title="Service Type" SortBy="q => q.ServiceType.ToString()" />
            <SortHeader Title="Total" SortBy="q => CalculateTotal(q)" />
            <SortHeader Title="Status" SortBy="q => q.IsComplete" />
            <th></th>
        </tr>
    </HeaderTemplate>

    <RowTemplate Context="q">
        <tr>
            <td>@($"AEM {q.QuoteNumber}")</td>
            <td>@($"AEM {q.ServiceReportNumber}")</td>
            <td>@q.ReportDate.ToString("dd/MM/yyyy")</td>
            <td>@q.Vehicle?.SerialNumber</td>
            <td style="max-width:400px">@q.Instruction</td>
            <td>@q.Client?.Name</td>
            <td>@q.ServiceType</td>
            <td>@CalculateTotal(q).ToString("C", CultureInfo.CurrentCulture)</td>
            <td>@(q.IsComplete == true ? "Complete" : "Incomplete")</td>
            <td>
                <Icon Name="IconName.Pencil" Size="IconSize.x5" Class="me-2" Color="IconColor.Primary" @onclick="() => EditQuote(q.Id)" Style="cursor: pointer" />
                <Icon Name="IconName.Printer" Size="IconSize.x5" Color="IconColor.Secondary" @onclick="() => PrintQuote(q.Id)" Style="cursor: pointer" />
            </td>
        </tr>
    </RowTemplate>
</ListTemplate>