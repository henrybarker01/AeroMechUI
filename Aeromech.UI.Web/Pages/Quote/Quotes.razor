@page "/quotes"
@using AeroMech.Models.Models

<PageTitle>Quotes</PageTitle>

<ListTemplate TItem="QuoteModel"
          Title="Quotes"
          Eyebrow="Workshop"
          Items="_quotes"
          PageSize="15"
          SearchPredicate="MatchesSearch"
          ShowAddButton="true"
          StorageKey="quotes"
          OnAdd="NavigateToAddQuote">
    <HeaderTemplate>
        <tr>
            <SortHeader Title="Quote Number" SortBy="q => q.QuoteNumber" />
            <SortHeader Title="Quote Date" SortBy="q => q.QuoteDate" />
            <SortHeader Title="Serial Number" SortBy="q => q.Vehicle?.SerialNumber" />
            <SortHeader Title="Instruction" SortBy="q => q.Instruction" />
            <SortHeader Title="Client" SortBy="q => q.Client?.Name" />
            <SortHeader Title="Service Type" SortBy="q => q.ServiceType.ToString()" />
            <SortHeader Title="Total" SortBy="q => CalculateTotal(q)" />
            <SortHeader Title="Status" SortBy="q => q.IsConverted" />
            <th></th>
        </tr>
    </HeaderTemplate>

    <RowTemplate Context="q">
        <tr>
            <td>@($"AEM {q.QuoteNumber}")</td>
            <td>@q.QuoteDate.ToString("dd/MM/yyyy")</td>
            <td>@q.Vehicle?.SerialNumber</td>
            <td class="instruction-col">@q.Instruction</td>
            <td>@q.Client?.Name</td>
            <td>@q.ServiceType</td>
            <td>@CalculateTotal(q).ToString("C", CultureInfo.CurrentCulture)</td>
            <td>
                @if (q.IsConverted)
                {
                    <span title="Converted to a service report">Converted to AEM @q.ServiceReportNumber</span>
                }
                else
                {
                    <span>Open</span>
                }
            </td>
            <td>
                <Icon Name="IconName.Pencil" Size="IconSize.x5" Class="me-2" Color="IconColor.Primary" @onclick="() => EditQuote(q.Id)" Style="cursor: pointer" />
                <Icon Name="IconName.Printer" Size="IconSize.x5" Class="me-2" Color="IconColor.Secondary" @onclick="() => PrintQuote(q.Id)" Style="cursor: pointer" />
                @if (!q.IsConverted)
                {
                    <Icon Name="IconName.FileEarmarkCheck" Size="IconSize.x5" Color="IconColor.Success" Title="Convert to service report" @onclick="() => ConvertQuote(q.Id)" Style="cursor: pointer" />
                }
            </td>
        </tr>
    </RowTemplate>
</ListTemplate>
