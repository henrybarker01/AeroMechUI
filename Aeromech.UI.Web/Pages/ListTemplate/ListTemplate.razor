@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]

<div class="list-page">
    @* Some callers embed this grid under a heading of their own and pass no
       title; they get the grid without a second header above it. *@
    @if (HasTitle || ShowAddButton)
    {
        <header class="page-header">
            <div class="page-header-text">
                @if (HasTitle && !string.IsNullOrWhiteSpace(Eyebrow))
                {
                    <p class="page-eyebrow">@Eyebrow</p>
                }
                @if (HasTitle)
                {
                    <h1 class="page-title">@Title</h1>
                }
            </div>

            @if (ShowAddButton)
            {
                <button type="button" class="btn btn-primary page-action" @onclick="OnAdd">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>@AddButtonLabel</span>
                </button>
            }
        </header>
    }

    @if (SearchPredicate is not null || FilterTemplate is not null)
    {
        <div class="list-toolbar">
            @if (SearchPredicate is not null)
            {
                <div class="list-search">
                    <i class="bi bi-search list-search-icon" aria-hidden="true"></i>
                    <input type="search" class="form-control" placeholder="@SearchPlaceholder"
                           aria-label="@SearchPlaceholder" @bind-value="SearchTerm" @bind-value:event="oninput" />
                </div>
            }
            @if (FilterTemplate is not null)
            {
                <div class="list-filters">
                    @FilterTemplate
                </div>
            }
        </div>
    }

    @* The grid sits in a card rather than running edge to edge, and no longer
       carries a fixed vh height - that produced a scrollbar inside a scrollbar on
       short screens and dead space below the rows on tall ones. *@
    <div class="data-card list-card">
        <div class="list-scroll">
            <table class="table table-hover">
                <thead>
                    <CascadingValue Value="this">
                        @HeaderTemplate
                    </CascadingValue>
                </thead>
                <tbody>
                    @if (PagedItems?.Any() == true)
                    {
                        @foreach (var item in PagedItems)
                        {
                            @RowTemplate(item)
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="999" class="list-empty">
                                @if (string.IsNullOrWhiteSpace(SearchTerm))
                                {
                                    <span>Nothing here yet.</span>
                                }
                                else
                                {
                                    <span>Nothing matches &ldquo;@SearchTerm&rdquo;.</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="list-pager">
            <span class="list-count">@RangeLabel</span>

            <div class="list-pager-controls">
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        disabled="@IsFirstPage" @onclick="PreviousPage">Previous</button>
                <span class="list-page-number">Page @CurrentPage of @TotalPages</span>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        disabled="@IsLastPage" @onclick="NextPage">Next</button>
            </div>
        </div>
    </div>
</div>
