@using BlazorBootstrap

<div class="widger-container">
    <table class="widget-data-table">
        <thead class="widget-data-header">
            <tr>
                <td class="widget-data-col">
                    Quote Number
                </td>
                <td class="widget-data-col">
                    Client
                </td>
                <td class="widget-data-col">
                    Status
                </td>
                <td class="widget-data-col report-date">
                    Date
                </td>
                <td class="widget-data-col">
                </td>
            </tr>
        </thead>
        <tbody class="widget-data-body">
            @foreach (var quote in quotes)
            {
                <tr class="widget-data-row">
                    <td class="widget-data-col report-number">
                        @($"AEM{@quote.QuoteNumber}")
                    </td>
                    <td class="widget-data-col">
                        @quote.Client?.Name
                    </td>
                    <td class="widget-data-col">
                        @(quote.IsConverted ? $"Converted to AEM{quote.ServiceReportNumber}" : "Open")
                    </td>
                    <td class="widget-data-col report-date">
                        @quote.QuoteDate.ToString("dd/MM/yyyy")
                    </td>
                    <td class="widget-data-col action-buttons">
                        <Icon Name="IconName.Pencil" Size="IconSize.x6" Class="me-2" Color="IconColor.Primary" @onclick="() => EditQuote(quote.Id)" Style="cursor: pointer" />
                        <Icon Name="IconName.Printer" Size="IconSize.x6" Color="IconColor.Secondary" @onclick="() => PrintQuote(quote.Id)" Style="cursor: pointer" />
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>
