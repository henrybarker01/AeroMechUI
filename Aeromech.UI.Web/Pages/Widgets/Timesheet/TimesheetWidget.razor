@using BlazorBootstrap

<div class="widger-container">
    <table class="widget-data-table">
        <thead class="widget-data-header">
            <tr>
                <td class="widget-data-col">
                    Day
                </td>
                <td class="widget-data-col">
                    Date
                </td>
                <td class="widget-data-col hours-col">
                    Hours
                </td>
                <td class="widget-data-col">
                </td>
            </tr>
        </thead>
        <tbody class="widget-data-body">
            @foreach (var day in weekDays)
            {
                <tr class="widget-data-row">
                    <td class="widget-data-col day-name">
                        @day.DayOfWeek
                    </td>
                    <td class="widget-data-col">
                        @day.Date.ToString("dd/MM/yyyy")
                    </td>
                    <td class="widget-data-col hours-col">
                        <span class="hours-badge @GetStatusClass(day.TotalWorked)">
                            @day.TotalWorked.ToString("0.0")
                        </span>
                    </td>
                    <td class="widget-data-col action-buttons">
                        <Icon Name="IconName.Eye" Size="IconSize.x6" Color="IconColor.Primary" @onclick="() => ViewTimesheet(day.Date)" Style="cursor: pointer" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (weekDays.Any())
    {
        <div class="week-summary">
            <strong>Weekly Total:</strong> @weekDays.Sum(d => d.TotalWorked).ToString("0.0") hours
        </div>
    }
</div>
