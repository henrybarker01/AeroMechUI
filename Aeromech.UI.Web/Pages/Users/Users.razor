@page "/users"
@inject LocalizationService L

<PageTitle>@L["Users"]</PageTitle>

<Modal @ref="_modal" Title="@_title">
    <BodyTemplate>
        <EditForm Model="@_user" OnValidSubmit=@SaveUser>
            <DataAnnotationsValidator />
            <div class="container-fluid">
                @if (!string.IsNullOrWhiteSpace(_modalErrorMessage))
                {
                    <div class="row">
                        <div class="col-12">
                            <div class="alert alert-danger" role="alert">
                                @_modalErrorMessage
                            </div>
                        </div>
                    </div>
                }
                <div class="row">
                    <div class="form-group">
                        <label for="email">@L["Email"]:</label>
                        <InputText @bind-Value=_user.Email class="form-control" id="email" />
                        <ValidationMessage For="() => _user.Email" />
                    </div>
                </div>
                <div class="row mt-5">
                    <div class="form-group">
                        <label for="user-name">@L["User Name"]:</label>
                        <InputText @bind-Value="_user.UserName" type="text" class="form-control" id="user-name"></InputText>
                        <ValidationMessage For="() => _user.UserName" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="phone-number">@L["Phone Number"]:</label>
                        <InputText @bind-Value="_user.PhoneNumber" type="phone" class="form-control" id="phone-nunmer"></InputText>
                        <ValidationMessage For="() => _user.PhoneNumber" />
                    </div>
                </div>
                @if (_isEdit)
                {
                    <div class="row mt-3">
                        <div class="form-check ms-2">
                            <input class="form-check-input" type="checkbox" id="reset-password" @bind="_resetPassword" />
                            <label class="form-check-label" for="reset-password">
                                @L["Reset this user's password"]
                            </label>
                        </div>
                    </div>
                }
                @if (!_isEdit || _resetPassword)
                {
                    <div class="row mt-3">
                        <div class="form-group">
                            <label for="password">@(_isEdit ? L["New password"] : L["Password"]):</label>
                            <InputText @bind-Value="_password" type="password" autocomplete="new-password" class="form-control" id="password"></InputText>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="form-group">
                            <label for="confirm-password">@(_isEdit ? L["Confirm new password"] : L["Confirm Password"]):</label>
                            <InputText @bind-Value="_confirmPassword" type="password" autocomplete="new-password" class="form-control" id="confirm-password"></InputText>
                        </div>
                    </div>
                }
                <div class="row mt-3">
                    <div class="form-check ms-2">
                        <input class="form-check-input" type="checkbox" id="must-change-password" @bind="_mustChangePassword" />
                        <label class="form-check-label" for="must-change-password">
                            @L["Must change password at next sign-in"]
                        </label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(PasswordPlanHint))
                {
                    <div class="row mt-2">
                        <div class="col-12">
                            <small class="text-muted ms-2">@PasswordPlanHint</small>
                        </div>
                    </div>
                }
            </div>
            <div class="row">
                <div class="footer-buttons">
                    <div class="close">
                        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">@L["Close"]</Button>
                    </div>
                    <div>
                        <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">@L["Save changes"]</Button>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>

<ListTemplate TItem="IdentityUser"
              Title="Users"
              Eyebrow="Administration"
              Items="_users"
              PageSize="15"
              SearchPredicate="MatchesSearch"
              ShowAddButton="true"
              StorageKey="users"
              OnAdd="AddUserClick">
    <HeaderTemplate>
        <tr>
            <SortHeader Title="User Name" SortBy="u => u.UserName" />
            <SortHeader Title="Email" SortBy="u => u.Email" />
            <SortHeader Title="Phone Number" SortBy="u => u.PhoneNumber" />
            <th class="row-actions-col">@L["Actions"]</th>
        </tr>
    </HeaderTemplate>
    <RowTemplate Context="user">
        <tr>
            <td>@user.UserName</td>
            <td>@user.Email</td>
            <td>@user.PhoneNumber</td>
            <td class="row-actions-col">
                <RowActions>
                    <RowAction Icon="@Icons.Edit" Label="@L["Edit this user"]" OnClick="() => EditUser(user)" />
                    <RowAction Icon="@Icons.Delete" Label="@L["Delete this user"]" Danger="true" OnClick="() => DeleteUser(user)" />
                </RowActions>
            </td>
        </tr>
    </RowTemplate>
</ListTemplate>
