@page "/employees"
@inject LocalizationService L

<PageTitle>@L["Employees"]</PageTitle>

<Modal @ref="modal" Title="@title">
    <BodyTemplate>
        <EditForm Model="@_employee" OnValidSubmit="@AddNewEmployee">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="container-fluid">
                <div class="row">
                    <div class="form-group">
                        <label for="title">@L["Title"]</label>
                        <select class="form-select" @bind="_employee.Title" aria-label="@L["Select Title"]" id="title">
                            <option selected>@L["Select Title"]</option>
                            <option value="Mr">Mr</option>
                            <option value="Ms">Ms</option>
                            <option value="Mrs">Mrs</option>
                        </select>
                        <ValidationMessage For="() => _employee.Title" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="name">@L["Name"]:</label>
                        <InputText @bind-Value="_employee.FirstName" type="text" class="form-control" id="name"></InputText>
                        <ValidationMessage For="() => _employee.FirstName" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="last-name">@L["Surname"]:</label>
                        <InputText @bind-Value="_employee.LastName" type="text" class="form-control" id="last-name"></InputText>
                        <ValidationMessage For="() => _employee.LastName" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="id-number">@L["ID Number"]:</label>
                        <InputText @bind-Value="_employee.IDNumber" type="text" class="form-control" id="id-number"></InputText>
                        <ValidationMessage For="() => _employee.IDNumber" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="phone-number">@L["Phone Number"]:</label>
                        <InputText @bind-Value="_employee.PhoneNumber" type="phone" class="form-control" id="phone-number"></InputText>
                        <ValidationMessage For="() => _employee.PhoneNumber" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="email">@L["Email"]:</label>
                        <InputText @bind-Value="_employee.Email" type="text" class="form-control" id="email"></InputText>
                        <ValidationMessage For="() => _employee.Email" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="addressLine1">@L["Address Line 1"]:</label>
                        <InputText @bind-Value="_employee.AddressLine1" type="text" class="form-control" id="addressLine1"></InputText>
                        <ValidationMessage For="() => _employee.AddressLine1" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="addressLine2">@L["Address Line 2"]:</label>
                        <InputText @bind-Value="_employee.AddressLine2" type="text" class="form-control" id="addressLine2"></InputText>
                        <ValidationMessage For="() => _employee.AddressLine2" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="city">@L["City"]:</label>
                        <InputText @bind-Value="_employee.City" type="text" class="form-control" id="city"></InputText>
                        <ValidationMessage For="() => _employee.City" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="postalCode">@L["Post Code"]:</label>
                        <InputText @bind-Value="_employee.PostalCode" type="text" class="form-control" id="postalCode"></InputText>
                        <ValidationMessage For="() => _employee.PostalCode" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="birth-date">@L["Date of Birth"]:</label>
                        <DateInput TValue="DateOnly?" @bind-Value="@_employee.BirthDate" id="birth-date" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group form-check">
                        <InputCheckbox @bind-Value="_employee.ExcludeFromTimesheets" class="form-check-input" id="exclude-from-timesheets" />
                        <label class="form-check-label" for="exclude-from-timesheets">@L["Exclude from timesheets"]</label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="footer-buttons">
                    <div class="close">
                        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">@L["Close"]</Button>
                    </div>
                    <div>
                        <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">@L["Save changes"]</Button>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>

<ListTemplate TItem="EmployeeModel"
              Title="Employees"
              Eyebrow="Directory"
              Items="_employees"
              PageSize="15"
              SearchPredicate="MatchesSearch"
              ShowAddButton="true"
              StorageKey="employees"
              OnAdd="OnShowModalClick">
    <HeaderTemplate>
        <tr>
            <SortHeader Title="Title" SortBy="e => e.Title" />
            <SortHeader Title="Name" SortBy="e => e.FirstName" />
            <SortHeader Title="Surname" SortBy="e => e.LastName" />
            <SortHeader Title="ID Number" SortBy="e => e.IDNumber" />
            <SortHeader Title="Phone Number" SortBy="e => e.PhoneNumber" />
            <SortHeader Title="Email" SortBy="e => e.Email" />
            <SortHeader Title="Timesheets" SortBy="e => e.ExcludeFromTimesheets" />
            <th class="row-actions-col">@L["Actions"]</th>
        </tr>
    </HeaderTemplate>
    <RowTemplate Context="employee">
        <tr>
            <td>@employee.Title</td>
            <td>@employee.FirstName</td>
            <td>@employee.LastName</td>
            <td>@employee.IDNumber</td>
            <td>@employee.PhoneNumber</td>
            <td>@employee.Email</td>
            <td>@(employee.ExcludeFromTimesheets ? L["Excluded"] : L["Included"])</td>

            <td class="row-actions-col">
                <RowActions>
                    <RowAction Icon="@Icons.Edit" Label="@L["Edit this employee"]" OnClick="() => OnEditEmployeeClick(employee)" />
                    <RowAction Icon="@Icons.Delete" Label="@L["Delete this employee"]" Danger="true" OnClick="() => DeleteEmployee(employee)" />
                </RowActions>
            </td>
        </tr>
    </RowTemplate>
</ListTemplate>
  