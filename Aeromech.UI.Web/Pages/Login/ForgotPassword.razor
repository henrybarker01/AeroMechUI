@layout LoginLayout
@page "/forgot-password"
@inject LocalizationService L
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>@L["Forgot Password"]</PageTitle>

@* The recovery card. The split landing shell (brand panel + card frame) is
   drawn by LoginLayout, shared with the sign-in page. *@

<div class="login-intro">
    <h1 class="login-title">@L["Forgot your password?"]</h1>
    <p class="login-subtitle">@L["Enter your email address and we will send you a link to reset it."]</p>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger login-alert" role="alert">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
        <span>@_errorMessage</span>
    </div>
}

@if (_linkSent)
{
    <div class="alert alert-success login-alert" role="alert">
        <i class="bi bi-check-circle" aria-hidden="true"></i>
        <span>@L["If that email address is registered, a reset link has been sent to it. Check your inbox."]</span>
    </div>

    <a class="btn btn-primary login-submit" href="/login">@L["Back to sign in"]</a>
}
else
{
    <form @onsubmit="SendLink" @onsubmit:preventDefault="true">
        <div class="login-field">
            <label class="login-label" for="email">@L["Email address"]</label>
            <input type="email" class="form-control" id="email" name="Email"
                   autocomplete="email" @bind="_email" placeholder="@L["e-mail"]" />
        </div>

        <button type="submit" class="btn btn-primary login-submit">@L["Send reset link"]</button>
    </form>

    <div class="login-links">
        <a href="/login">@L["Back to sign in"]</a>
    </div>
}
