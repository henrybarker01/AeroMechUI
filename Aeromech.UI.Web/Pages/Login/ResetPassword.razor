@layout LoginLayout
@page "/reset-password"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Reset Password</PageTitle>

@* The recovery card. The split landing shell (brand panel + card frame) is
   drawn by LoginLayout, shared with the sign-in page. *@

<div class="login-intro">
    <h1 class="login-title">Reset your password</h1>
    <p class="login-subtitle">Choose a new password for your account.</p>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger login-alert" role="alert">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
        <span>@_errorMessage</span>
    </div>
}

@if (_resetDone)
{
    <div class="alert alert-success login-alert" role="alert">
        <i class="bi bi-check-circle" aria-hidden="true"></i>
        <span>Your password has been reset. Sign in with your new password.</span>
    </div>

    <a class="btn btn-primary login-submit" href="/login">Go to sign in</a>
}
else if (_linkInvalid)
{
    <div class="alert alert-danger login-alert" role="alert">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
        <span>This reset link is incomplete or has expired. Request a new one.</span>
    </div>

    <a class="btn btn-primary login-submit" href="/forgot-password">Request a new link</a>
}
else
{
    <form @onsubmit="ResetPasswordAsync" @onsubmit:preventDefault="true">
        <div class="login-field">
            <label class="login-label" for="new-password">New password</label>
            <input type="password" class="form-control" id="new-password" name="NewPassword"
                   autocomplete="new-password" @bind="_newPassword" placeholder="New password" />
        </div>

        <div class="login-field">
            <label class="login-label" for="confirm-password">Confirm new password</label>
            <input type="password" class="form-control" id="confirm-password" name="ConfirmPassword"
                   autocomplete="new-password" @bind="_confirmPassword" placeholder="Confirm new password" />
        </div>

        <button type="submit" class="btn btn-primary login-submit">Reset password</button>
    </form>

    <div class="login-links">
        <a href="/login">Back to sign in</a>
    </div>
}
