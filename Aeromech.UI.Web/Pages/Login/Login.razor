@layout LoginLayout
@page "/login"
@inject LocalizationService L
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

@* The sign-in card. The split landing shell (brand panel + card frame) is
   drawn by LoginLayout, shared with the password-recovery pages. *@

<div class="login-intro">
    <h1 class="login-title">@L["Sign in"]</h1>
    <p class="login-subtitle">@L["Enter your details to continue to AeroMech."]</p>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger login-alert" role="alert">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
        <span>@_errorMessage</span>
    </div>
}

<form method="post" action="/Account/SignIn" id="loginForm" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
    <div class="login-field">
        <label class="login-label" for="user-name">@L["User name"]</label>
        <input type="text" class="form-control" id="user-name" name="UserName"
               autocomplete="username" @bind="_credential.UserName" placeholder="@L["e-mail"]" />
    </div>

    <div class="login-field">
        <label class="login-label" for="password">@L["Password"]</label>
        <input type="password" class="form-control" id="password" name="Password"
               autocomplete="current-password" @bind="_credential.Password" placeholder="@L["Password"]" />
    </div>

    <button type="submit" id="login" name="login" class="btn btn-primary login-submit">@L["Sign in"]</button>
</form>

<div class="login-links">
    <a href="/forgot-password">@L["Forgot your password?"]</a>
</div>
