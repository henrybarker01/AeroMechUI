 @page "/add-client"
@inject LocalizationService L

<PageTitle>@L["Add Client"]</PageTitle>


<h1>@L["Add Client"]</h1>


<EditForm Model="@client" OnValidSubmit="AddNewClient">
	<div class="container-fluid">
		<div class="row">
			<div class="form-group mb-20">
				<label for="email">@L["Client Name"]:</label>
				<InputText @bind-Value="client.Name" type="text" class="form-control" id="name"></InputText>
			</div>
		</div>
		<div class="row mt-5">
			<div class="form-group">
				<label for="contact-person-name">@L["Contact Person Name"]:</label>
				<InputText @bind-Value="client.ContactPersonName" type="text" class="form-control" id="contact-person-name"></InputText>
			</div>
		</div>
		<div class="row mt-3">
			<div class="form-group">
				<label for="contact-person-number">@L["Contact Person Number"]:</label>
				<InputText @bind-Value="client.ContactPersonNumber" type="phone" class="form-control" id="contact-person-nunmer"></InputText>
			</div>
		</div>
		<div class="row mt-3">
			<div class="form-group">
				<label for="contact-person-email">@L["Contact Person Email"]:</label>
				<InputText @bind-Value="client.ContactPersonEmail" type="email" class="form-control" id="contact-person-email"></InputText>
			</div>
		</div>
		<div class="row mt-5">
			<div class="form-group">
				<label for="addressLine1">@L["Address Line 1"]:</label>
				<InputText @bind-Value="client.AddressLine1" type="text" class="form-control" id="addressLine1"></InputText>
			</div>
		</div>
		<div class="row mt-3">
			<div class="form-group">
				<label for="addressLine2">@L["Address Line 2"]:</label>
				<InputText @bind-Value="client.AddressLine2" type="text" class="form-control" id="addressLine2"></InputText>
			</div>
		</div>
		<div class="row mt-3">
			<div class="form-group">
				<label for="city">@L["City"]:</label>
				<InputText @bind-Value="client.City" type="text" class="form-control" id="city"></InputText>
			</div>
		</div>
		<div class="row mt-3">
			<div class="form-group">
				<label for="postalCode">@L["Post Code"]:</label>
				<InputText @bind-Value="client.PostalCode" type="text" class="form-control" id="postalCode"></InputText>
			</div>
		</div>

		<div class="row mt-5">
			<div class="col-1 me-5">
				<button class="btn btn-primary pe-4 ps-4">@L["Save"]</button>
			</div>
			<div class="col-1">
				<button class="btn btn-secondary pe-4 ps-4" @onclick="@OnCloseClick">@L["Close"]</button>
			</div>


		</div>

	</div>




</EditForm>

<div>
</div>


