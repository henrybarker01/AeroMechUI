@page "/service-reports"

@using AeroMech.UI.Web.Pages.ListTemplate;
@using System.Globalization;
@using AeroMech.Models;
@using BlazorBootstrap

<PageTitle>Service Reports</PageTitle>

<ListTemplate TItem="ServiceReportModel"
              Title="Service Reports"
              Items="FilteredServiceReports"
              PageSize="15"
              SearchPredicate="MatchesSearch"
              ShowAddButton="true"
              StorageKey="service-reports"
              OnAdd="NavigateToAdd">
    <FilterTemplate>
        <div class="sr-status-filter">
            @foreach (var status in Statuses)
            {
                <button type="button"
                        class="sr-status-chip @status.Css @(IsStatusActive(status) ? "active" : null)"
                        title="@status.Description"
                        aria-pressed="@(IsStatusActive(status) ? "true" : "false")"
                        @onclick="() => ToggleStatus(status)">
                    <span class="sr-status-dot"></span>
                    @status.Label
                    <span class="sr-status-count">@CountFor(status)</span>
                </button>
            }
            @if (_activeStatuses.Count > 0)
            {
                <button type="button" class="sr-status-clear" @onclick="ClearStatusFilter">Clear</button>
            }
        </div>
    </FilterTemplate>

    <HeaderTemplate>
        <tr>
            <SortHeader Title="Report Number" SortBy="sr => sr.ServiceReportNumber" />
            <SortHeader Title="Quote Number" SortBy="sr => sr.QuoteNumber" />
            <SortHeader Title="Report Date" SortBy="sr => sr.ReportDate" />
            <SortHeader Title="Sales Order Number" SortBy="sr => sr.SalesOrderNumber" />
            <SortHeader Title="Serial Number" SortBy="sr => sr.Vehicle?.SerialNumber" />
            <SortHeader Title="Instruction" SortBy="sr => sr.Instruction" />
            <SortHeader Title="Client" SortBy="sr => sr.Client?.Name" />
            <SortHeader Title="Service Type" SortBy="sr => sr.ServiceType.ToString()" />
            <SortHeader Title="Total" SortBy="sr => CalculateTotal(sr)" />
            <SortHeader Title="Status" SortBy="sr => RowStatus(sr).Rank" />
            <th></th>
        </tr>
    </HeaderTemplate>

    <RowTemplate Context="sr">
        @{
            var status = RowStatus(sr);
        }
        <tr class="sr-row @status.Css">
            <td class="sr-status-cell" title="@status.Description">@($"AEM {sr.ServiceReportNumber}")</td>
            <td>@($"AEM {sr.QuoteNumber}")</td>
            <td>@sr.ReportDate.ToString("dd/MM/yyyy")</td>
            <td>@sr.SalesOrderNumber</td>
            <td>@sr.Vehicle?.SerialNumber</td>
            <td class="sr-instruction" title="@sr.Instruction">@sr.Instruction</td>
            <td class="sr-client" title="@sr.Client?.Name">@sr.Client?.Name</td>
            <td>@sr.ServiceType</td>
            <td>@CalculateTotal(sr).ToString("C", CultureInfo.CurrentCulture)</td>
            <td>@status.Label</td>
            <td>
                <Icon Name="IconName.Pencil" Size="IconSize.x5" Class="me-2" Color="IconColor.Primary" @onclick="() => Edit(sr.Id)" Style="cursor: pointer" />
                <Icon Name="IconName.Printer" Size="IconSize.x5" Color="IconColor.Secondary" @onclick="() => Print(sr.Id)" Style="cursor: pointer" />
            </td>
        </tr>
    </RowTemplate>
</ListTemplate>