@page "/timesheets"
@page "/timesheets/{SelectedDate}"
@using AeroMech.Models.Models

<PageTitle>Time Sheet Data</PageTitle>

<Modal @ref="_modal" Title="@_title">
    <BodyTemplate>
        <EditForm Model="@_timesheetEmployeeDetail" OnValidSubmit="AddLineToEmployeeTimesheetDetailAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="container-fluid">
                <div class="row">
                    <div class="form-group">
                        <label for="description">Description</label>
                        <InputSelect @bind-Value="_timesheetEmployeeDetail.Description" class="form-control" id="description">
                            @foreach (var gapType in Enum.GetValues<AeroMech.Data.Enums.TimesheetGapTypes>())
                            {
                                <option value="@gapType">@gapType</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _timesheetEmployeeDetail.Description" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="form-group">
                        <label for="hours">Hours:</label>
                        <NumberInput @bind-Value="_timesheetEmployeeDetail.Hours" type="text" class="form-control" id="hours"></NumberInput>
                        <ValidationMessage For="() => _timesheetEmployeeDetail.Hours" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="footer-buttons">
                    <div class="close">
                        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Close</Button>
                    </div>
                    <div>
                        <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save changes</Button>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>

<div class="timesheets d-flex">
    <div class="col-6 time-sheet-data">
        <div class="form-group pe-2">
            <header class="page-header">
                <div class="page-header-text">
                    <p class="page-eyebrow">Workshop</p>
                    <h1 class="page-title">Time sheet data</h1>
                </div>
            </header>
            <InputDate TValue="DateOnly"
                       @bind-Value="_startDate"
                       @bind-Value:after="LoadTimesheetsAsync"
                       class="form-control"
                       id="from-date" />
        </div>
        <ListTemplate TItem="TimesheetDateModel"
                      Title=""
                      Items="_timesheets"
                      PageSize="15"
                      ShowAddButton="false"
                      StorageKey="timesheet-dates">
            <HeaderTemplate>
                <tr>
                    <SortHeader Title="Date" SortBy="t => t.Date" />
                    <SortHeader Title="Day" SortBy="t => t.DayOfWeek" />
                    <SortHeader Title="Total Hours" SortBy="t => t.TotalWorked" />
                    <th></th>
                </tr>
            </HeaderTemplate>
            <RowTemplate Context="timesheet">
                <tr class="@(timesheet.Date == _selectedTimesheetDate ? "selected-row" : string.Empty)">
                    <td>@timesheet.Date</td>
                    <td>@timesheet.DayOfWeek</td>
                    <td>@timesheet.TotalWorked</td>
                    <td>
                        <div class="action-col">
                            <Icon Name="IconName.Eye"
                                  Size="IconSize.x5"
                                  Color="IconColor.Primary"
                                  @onclick="async () => await ViewDayAsync(timesheet)"
                                  Class="me-2"
                                  Style="cursor: pointer" />
                            <Icon Name="IconName.Printer"
                                  Size="IconSize.x5"
                                  Color="IconColor.Secondary"
                                  @onclick="() => PrintDay(timesheet)"
                                  Style="cursor: pointer" />
                        </div>
                    </td>
                </tr>
            </RowTemplate>
        </ListTemplate>
    </div>
    <div class="col-6">
        <div class="d-flex flex-column h-100">
            <div class="col-12 flex-fill half-view-height">
                <ListTemplate TItem="TimesheetEmployeeHoursModel"
                              Title=""
                              Items="_timesheetEmployeeHours"
                              PageSize="15"
                              ShowAddButton="false"
                              StorageKey="timesheet-employees">
                    <HeaderTemplate>
                        <tr>
                            <SortHeader Title="Employee #" SortBy="e => e.EmployeeNumber" />
                            <SortHeader Title="Name" SortBy="e => e.EmployeeName" />
                            <SortHeader Title="SR Hours" SortBy="e => e.ServiceReportHours" />
                            <SortHeader Title="Other Hours" SortBy="e => e.TimesheetHours" />
                            <SortHeader Title="Total Hours" SortBy="e => e.ServiceReportHours + e.TimesheetHours" />
                            <th></th>
                        </tr>
                    </HeaderTemplate>
                    <RowTemplate Context="timesheetEmployee">
                        <tr class="@(timesheetEmployee.EmployeeId == _selectedEmployeeId ? "selected-row" : string.Empty)">
                            <td>@timesheetEmployee.EmployeeNumber</td>
                            <td>@timesheetEmployee.EmployeeName</td>
                            <td>@timesheetEmployee.ServiceReportHours</td>
                            <td>@timesheetEmployee.TimesheetHours</td>
                            <td>@(timesheetEmployee.ServiceReportHours + timesheetEmployee.TimesheetHours)</td>
                            <td>
                                <div>
                                    <Icon Name="IconName.Eye"
                                          Size="IconSize.x5"
                                          Color="IconColor.Primary"
                                          @onclick="async () => await ViewEmplyeeTimesheetDetail(timesheetEmployee.EmployeeId)"
                                          Class="me-2"
                                          Style="cursor: pointer" />
                                    <Icon Name="IconName.Plus"
                                          Size="IconSize.x5"
                                          Color="IconColor.Danger"
                                          @onclick="(async () => await AddToEmployeeTimesheetAsync(timesheetEmployee))"
                                          Class="me-2"
                                          Style="cursor: pointer" />
                                </div>
                            </td>
                        </tr>
                    </RowTemplate>
                </ListTemplate>
            </div>
            <div class="col-12 flex-fill half-view-height">
                <ListTemplate TItem="TimesheetEmployeeLineModel"
                              Title=""
                              Items="_timesheetEmployeeDetails"
                              PageSize="15"
                              ShowAddButton="true"
                              StorageKey="timesheet-employee-lines"
                              OnAdd="@(async () => await AddToEmployeeTimesheetAsync())">
                    <HeaderTemplate>
                        <tr>
                            <SortHeader Title="Description" SortBy="l => l.Description" />
                            <SortHeader Title="Source" SortBy="l => l.IsServiceReport" />
                            <SortHeader Title="Total Hours" SortBy="l => l.Hours" />
                            <th></th>
                        </tr>
                    </HeaderTemplate>
                    <RowTemplate Context="timesheetLine">
                        <tr>
                            <td>@timesheetLine.Description</td>
                            <td>@(timesheetLine.IsServiceReport ? "Service Report" : "Timesheet")</td>
                            <td>@timesheetLine.Hours</td>

                            <td>
                                <div class="action-col">
                                    @if (timesheetLine.IsServiceReport)
                                    {
                                        <Icon Name="IconName.Eye"
                                              Size="IconSize.x5"
                                              Color="IconColor.Primary"
                                              @onclick="() => ViewServiceReport(timesheetLine.ServiceReportId!.Value)"
                                              Class="me-2"
                                              Style="cursor: pointer" />
                                    }
                                    else
                                    {
                                        <Icon Name="IconName.Pencil"
                                              Size="IconSize.x5"
                                              Color="IconColor.Dark"
                                              @onclick="async () => await EditEmployeeTimesheetAsync(timesheetLine)"
                                              Class="me-2"
                                              Style="cursor: pointer" />
                                        <Icon Name="IconName.Trash"
                                              Size="IconSize.x5"
                                              Color="IconColor.Danger"
                                              @onclick="async () => await DeleteEmployeeTimesheetDetailAsync(timesheetLine)"
                                              Class="me-2"
                                              Style="cursor: pointer" />
                                    }
                                </div>
                            </td>
                        </tr>
                    </RowTemplate>
                </ListTemplate>
            </div>
        </div>

    </div>
</div>

