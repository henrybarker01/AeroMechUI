@page "/"
@inject LocalizationService L
@using AeroMech.UI.Web.Pages.Dashboard

<PageTitle>@L["Home"]</PageTitle>

@* The route is shared by two different screens, so this page is only the shell that picks
   between them and fetches what the dashboard needs. The dashboard itself is DashboardView. *@
<AuthorizeView>
	<Authorized>
		@if (_model is null)
		{
			<p class="dash-loading">@L["Reading the workshop"]&hellip;</p>
		}
		else
		{
			<DashboardView Model="_model" />
		}
	</Authorized>
	<NotAuthorized>
		<RedirectToLogin />
	</NotAuthorized>
</AuthorizeView>
