@using AeroMech.UI.Web.Shared
@using AeroMech.UI.Web.Services
@inject LocalizationService L

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    /// <summary>
    /// The language _Host read from the cookie. Applied before the router renders
    /// anything, so the entire first paint is already in the right language.
    /// </summary>
    [Parameter] public string? InitialLanguage { get; set; }

    protected override void OnInitialized() => L.SetInitialLanguage(InitialLanguage);
}