

@inject LocalizationService L

@if (IsVisible)
{
    <div class="modal-overlay">
    <div class="c-modal">
            <p>@Message</p>
            <button @onclick="() => Confirm(true)">@L["Yes"]</button>
            <button @onclick="() => Confirm(false)">@L["No"]</button>
        </div>
    </div>
}


