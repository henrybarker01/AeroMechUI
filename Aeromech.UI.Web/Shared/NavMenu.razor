@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img class="brand-mark" src="images/aeromech-mark.png" alt="" aria-hidden="true" width="28" height="28" />
            <span class="brand-name">AeroMech</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@* Each section gets the icon that matches it. The markup previously asked for
   classes from the Blazor starter template (bi-*-nav-menu) which this project
   never defined, so every icon rendered at 0x0 - and all of them asked for the
   same glyph, so they would have carried no meaning even had they shown.
   Bootstrap Icons is already loaded in _Host.cshtml, so these are its own names. *@
<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door nav-icon" aria-hidden="true"></i>
                <span class="nav-text">Home</span>
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="clients">
                        <i class="bi bi-buildings nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Clients</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="employees">
                        <i class="bi bi-people nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Employees</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="vehicles">
                        <i class="bi bi-truck nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Vehicles</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="parts">
                        <i class="bi bi-box-seam nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Parts</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="receive-stock">
                        <i class="bi bi-box-arrow-in-down nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Receive Stock</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="stock-receipts">
                        <i class="bi bi-clipboard-check nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Stock Receipts</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="stock-takes">
                        <i class="bi bi-clipboard-data nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Stock Takes</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="quotes">
                        <i class="bi bi-file-earmark-text nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Quotes</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="service-reports">
                        <i class="bi bi-wrench-adjustable nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Service Reports</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="timesheets">
                        <i class="bi bi-clock-history nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Time Sheet Data</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reports">
                        <i class="bi bi-bar-chart-line nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Reports</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">
                        <i class="bi bi-person-gear nav-icon" aria-hidden="true"></i>
                        <span class="nav-text">Users</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="nav-actions">
                <button class="nav-action nav-action-primary" @onclick="NavigateToAddQuote">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> New quote
                </button>
                <button class="nav-action nav-action-secondary" @onclick="NavigateToAddServiceReport">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> New service report
                </button>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void NavigateToAddServiceReport() => NavigationManager.NavigateTo("add-service-report");

    private void NavigateToAddQuote() => NavigationManager.NavigateTo("add-quote");
}
