@using System.Security.Claims

<AuthorizeView>
    <Authorized>
        @* The user chip doubles as the account menu. Bootstrap's dropdown data API
           (bundle already loaded in _Host) drives open/close, so no JS interop or
           component state is needed here. *@
        <div class="dropdown">
            <button type="button" class="user-chip" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                <span class="user-avatar" aria-hidden="true">@Initials(context.User)</span>
                <span class="user-name">@context.User.Identity?.Name</span>
                <i class="bi bi-chevron-down user-caret" aria-hidden="true"></i>
            </button>

            <ul class="dropdown-menu dropdown-menu-end user-menu">
                <li>
                    <a class="dropdown-item" href="/change-password">
                        <i class="bi bi-key" aria-hidden="true"></i>
                        <span>Change password</span>
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form method="post" action="Identity/Account/Logout" class="logout-form">
                        <button type="submit" class="dropdown-item">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            <span>Log out</span>
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </Authorized>
    <NotAuthorized>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Falls back to the first character of whatever the name is, so the chip is
    // never empty for accounts that are a bare user name rather than a full name.
    private static string Initials(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;

        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(new[] { ' ', '.', '@', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[1][0]));
        }

        return char.ToUpperInvariant(parts[0][0]).ToString();
    }
}
