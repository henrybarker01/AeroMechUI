@using AeroMech.UI.Web.Components
@using BlazorBootstrap
@inherits LayoutComponentBase


<PageTitle>Aeromech.UI.Web</PageTitle>

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>

    <main>
        <Loader/>
        <ConfirmationModal />
        <Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />
        <AuthorizeView>
            <Authorized>
                <div class="top-row px-4">
                    <LoginDisplay />
                </div>
            </Authorized>
        </AuthorizeView>

        <article class="content px-4 main-view-port">
            
            @Body
        </article>
    </main>
</div>
 
